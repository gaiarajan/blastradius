@prefix br:   <http://blastradius.dev/ontology#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# ============================================================
# ONTOLOGY
# ============================================================

# --- Classes ---

br:Dependency a rdfs:Class ;
    rdfs:comment "Abstract superclass for anything a Service can depend on" .

br:Service a rdfs:Class ;
    rdfs:subClassOf br:Dependency ;
    rdfs:comment "A deployable backend service" .

br:Database a rdfs:Class ;
    rdfs:subClassOf br:Dependency ;
    rdfs:comment "A persistent data store" .

br:Package a rdfs:Class ;
    rdfs:subClassOf br:Dependency ;
    rdfs:comment "An external library or package dependency" .

br:APIEndpoint a rdfs:Class ;
    rdfs:comment "A specific endpoint exposed by a Service" .

br:Team a rdfs:Class ;
    rdfs:comment "A team that owns one or more services" .

# --- Properties ---

br:dependsOn a rdf:Property ;
    rdfs:domain br:Service ;
    rdfs:range br:Dependency ;
    rdfs:comment "Service A requires Dependency B to function" .

br:calls a rdf:Property ;
    rdfs:domain br:Service ;
    rdfs:range br:Service ;
    rdfs:comment "Service A makes runtime calls to Service B" .

br:fallbackTo a rdf:Property ;
    rdfs:domain br:Dependency ;
    rdfs:range br:Dependency ;
    rdfs:comment "If the subject is unavailable, the object can serve as a substitute, dampening cascade impact" .

br:ownedBy a rdf:Property ;
    rdfs:domain br:Service ;
    rdfs:range br:Team ;
    rdfs:comment "Which team is responsible for a service" .

br:impactWeight a rdf:Property ;
    rdfs:comment "Qualifier (0.0-1.0) on a dependsOn/calls edge via RDF-star, indicating how severely failure propagates across it" .

br:syncType a rdf:Property ;
    rdfs:comment "Qualifier on a calls edge via RDF-star: sync or async" .

# ============================================================
# SEED DATA
# ============================================================

# --- Teams ---

br:team_platform a br:Team .
br:team_checkout a br:Team .
br:team_catalog a br:Team .

# --- Services ---

br:frontend        a br:Service ; br:ownedBy br:team_platform .
br:api_gateway       a br:Service ; br:ownedBy br:team_platform .
br:auth_service       a br:Service ; br:ownedBy br:team_platform .
br:checkout_service   a br:Service ; br:ownedBy br:team_checkout .
br:payment_api        a br:Service ; br:ownedBy br:team_checkout .
br:payment_api_backup  a br:Service ; br:ownedBy br:team_checkout .
br:inventory_service  a br:Service ; br:ownedBy br:team_catalog .
br:catalog_service    a br:Service ; br:ownedBy br:team_catalog .

# --- Databases ---

br:user_db      a br:Database .
br:warehouse_db a br:Database .
br:catalog_db   a br:Database .

# --- Dependency edges ---

br:frontend br:dependsOn br:api_gateway .
br:api_gateway br:dependsOn br:auth_service .
br:auth_service br:dependsOn br:user_db .
br:api_gateway br:dependsOn br:checkout_service .
br:api_gateway br:dependsOn br:catalog_service .
br:checkout_service br:dependsOn br:payment_api .
br:checkout_service br:dependsOn br:inventory_service .
br:inventory_service br:dependsOn br:warehouse_db .
br:catalog_service br:dependsOn br:catalog_db .

# --- Fallback edge (dampens cascade instead of propagating) ---

br:payment_api br:fallbackTo br:payment_api_backup .

# --- Call edges (runtime, may differ from dependsOn topology) ---

br:checkout_service br:calls br:catalog_service .

# ============================================================
# RDF-star qualifiers on the above edges
# ============================================================

<< br:frontend br:dependsOn br:api_gateway >> br:impactWeight "1.0"^^xsd:decimal .
<< br:api_gateway br:dependsOn br:auth_service >> br:impactWeight "1.0"^^xsd:decimal .
<< br:auth_service br:dependsOn br:user_db >> br:impactWeight "1.0"^^xsd:decimal .
<< br:api_gateway br:dependsOn br:checkout_service >> br:impactWeight "0.9"^^xsd:decimal .
<< br:api_gateway br:dependsOn br:catalog_service >> br:impactWeight "0.6"^^xsd:decimal .
<< br:checkout_service br:dependsOn br:payment_api >> br:impactWeight "0.9"^^xsd:decimal .
<< br:checkout_service br:dependsOn br:inventory_service >> br:impactWeight "0.7"^^xsd:decimal .
<< br:inventory_service br:dependsOn br:warehouse_db >> br:impactWeight "1.0"^^xsd:decimal .
<< br:catalog_service br:dependsOn br:catalog_db >> br:impactWeight "1.0"^^xsd:decimal .

<< br:checkout_service br:calls br:catalog_service >> br:syncType "sync" .
